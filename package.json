{
  "name": "minimal-typescript-setup",
  "private": true,
  "version": "1.0.0",
  "description": "Minimal TypeScript project setup for curious minds",
  "main": "index.js",
  "scripts": {
    "2022": "ts-node ./src/2022",
    "2023": "ts-node ./src/2023",
    "new": "tsx src/aoc/cli.ts new",
    "dev": "tsx src/aoc/cli.ts dev",
    "submit": "tsx src/aoc/cli.ts submit",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "build": "tsc --build",
    "lint": "tsc --noEmit && eslint \\\"**/*.ts\\\" --quiet --fix"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bobaekang/minimal-typescript-setup.git"
  },
  "keywords": [
    "minimal",
    "typescript",
    "setup"
  ],
  "author": "Bobae Kang",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/bobaekang/minimal-typescript-setup/issues"
  },
  "homepage": "https://github.com/bobaekang/minimal-typescript-setup#readme",
  "devDependencies": {
    "@types/node": "24.19.2",
    "@typescript-eslint/eslint-plugin": "5.48.1",
    "@typescript-eslint/parser": "5.48.1",
    "eslint": "8.31.0",
    "eslint-config-prettier": "8.6.0",
    "eslint-plugin-prettier": "4.2.1",
    "prettier": "2.8.2",
    "ts-node": "10.9.1",
    "tsx": "^4.23.15",
    "typescript": "5.9.3",
    "vitest": "^5.1.0"
  }
}
